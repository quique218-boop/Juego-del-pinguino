<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="vista.LoginMultipleController"
      alignment="CENTER"
      spacing="15"
      style="-fx-background-color: rgba(0,0,0,0.4); -fx-padding: 30;">

    <!-- 🔥 Jugador actual -->
    <Label fx:id="textoJugador"
           text="Jugador 1"
           style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;"/>

    <!-- Título -->
    <Label text="Iniciar sesión"
           style="-fx-text-fill: white; -fx-font-size: 16;"/>

    <!-- Usuario -->
    <TextField fx:id="userField"
               promptText="Usuario"
               prefWidth="200"/>

    <!-- Contraseña -->
    <PasswordField fx:id="passField"
                   promptText="Contraseña"
                   prefWidth="200"/>

    <!-- Botón login -->
    <Button text="Entrar"
            onAction="#onEnter"
            prefWidth="200"
            style="-fx-background-color: #2F91ED; -fx-text-fill: white;"/>

    <!-- 🔥 Mensaje error -->
    <Label fx:id="mensajeError"
           text=""
           style="-fx-text-fill: red;"/>

    <!-- 🔥 Crear usuario -->
    <Button text="Crear usuario"
            onAction="#crearUsuario"
            prefWidth="200"
            style="-fx-background-color: #22c55e; -fx-text-fill: white;"/>

</VBox>