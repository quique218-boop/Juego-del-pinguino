<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<StackPane stylesheets="@Victoria.css"
           xmlns="http://javafx.com/javafx/21.0.1"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="vista.Victoria">

    <children>

        <VBox alignment="CENTER"
              spacing="25"
              styleClass="panel-victoria"
              maxWidth="700">

            <padding>
                <Insets top="40" right="40" bottom="40" left="40"/>
            </padding>

            <Text fx:id="tituloVictoria"
                  styleClass="titulo-victoria"
                  text="VICTORIA"/>

            <ImageView fx:id="imagenResultado"
                       fitWidth="220"
                       fitHeight="220"
                       preserveRatio="true"/>

            <Text fx:id="mensajeVictoria"
                  styleClass="mensaje-victoria"
                  text="Texto"/>

            <Text fx:id="textoGanador"
                  styleClass="ganador-text"
                  text="Ganador"/>

            <Text fx:id="textoPuntuacion"
                  styleClass="puntuacion-text"
                  text="Puntuación: 0"/>

            <Button fx:id="volver"
                    mnemonicParsing="false"
                    onAction="#volver"
                    styleClass="boton-menu"
                    text="Volver al menú"/>

        </VBox>

    </children>

</StackPane>