<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>

<VBox xmlns="http://javafx.com/javafx/21.0.1"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="vista.CrearUsuarioController"
      alignment="CENTER"
      spacing="15"
      style="-fx-background-color: rgba(0,0,0,0.4); -fx-padding: 30;">

    <Label text="Crear Usuario"
           style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;"/>

    <TextField fx:id="userField" promptText="Usuario" prefWidth="200"/>

    <PasswordField fx:id="passField" promptText="Contraseña" prefWidth="200"/>

    <PasswordField fx:id="confirmField" promptText="Confirmar contraseña" prefWidth="200"/>

    <Label fx:id="mensajeError" text="" style="-fx-text-fill: red;"/>

    <Button text="Crear cuenta"
        onAction="#crearUsuario"
        prefWidth="200"
        style="-fx-background-color: #22c55e; -fx-text-fill: white;" />

    <Button text="Volver al login"
            onAction="#volverLogin"
            prefWidth="200"/>

</VBox>